[
  {
    "id": 1,
    "priority": 1,
    "action": {
      "type": "redirect",
      "redirect": {
        "transform": {
          "queryTransform": {
            "removeParams": ["region"],
            "addOrReplaceParams": [{ "key": "region", "value": "us-east-1" }]
          }
        }
      }
    },
    "condition": {
      "regexFilter": "https://[^/]*console\\.aws\\.amazon\\.com/.*[?&]region=us-east-2([&#]|$)",
      "resourceTypes": ["main_frame"]
    }
  },
  {
    "id": 2,
    "priority": 1,
    "action": {
      "type": "redirect",
      "redirect": {
        "transform": {
          "host": "us-east-1.console.aws.amazon.com",
          "queryTransform": {
            "addOrReplaceParams": [{ "key": "region", "value": "us-east-1" }]
          }
        }
      }
    },
    "condition": {
      "regexFilter": "^https://us-east-2\\.console\\.aws\\.amazon\\.com/.*",
      "resourceTypes": ["main_frame"]
    }
  }
]
